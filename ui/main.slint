import { StandardListView, VerticalBox, HorizontalBox, Button, ProgressIndicator, ScrollView, ListView, LineEdit, ComboBox, Slider } from "std-widgets.slint";

export struct TrackData {
    id: int,
    path: string,
    filename: string,
    title: string,
    artist: string,
    album: string,
    duration: string,
    sample_rate: string,
    bit_depth: string,
    channels: string,
    mtime: string,
    bpm: string,
    musical_key: string,
    is_favorite: bool,
}

export struct FolderItem {
    path: string,
    name: string,
    indent: length,
    is-expanded: bool,
    has-children: bool,
}

// Minimal right-click menu built on PopupWindow (Slint 1.7 has no
// native context-menu widget). Closes on any inside/outside click.
component CtxMenu {
    in property <length> menu-x: 0px;
    in property <length> menu-y: 0px;
    in property <[string]> items: [];
    callback item-clicked(int);

    popup := PopupWindow {
        x: root.menu-x;
        y: root.menu-y;
        width: 200px;
        height: root.items.length * 26px + 10px;
        close-on-click: true;

        Rectangle {
            width: 100%;
            height: 100%;
            background: #232323;
            border-radius: 4px;
            border-width: 1px;
            border-color: #555;
            clip: true;

            VerticalLayout {
                padding: 5px;
                spacing: 0px;
                for label[i] in root.items: Rectangle {
                    height: 26px;
                    border-radius: 3px;
                    background: item-ta.has-hover ? #3a5a8c : transparent;
                    item-ta := TouchArea {
                        clicked => { root.item-clicked(i); }
                    }
                    Text {
                        text: label;
                        color: #ddd;
                        font-size: 12px;
                        x: 8px;
                        width: parent.width - 16px;
                        height: parent.height;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }
            }
        }
    }

    public function show() {
        popup.show();
    }
}

export component AppWindow inherits Window {
    title: "sampleman";
    preferred-width: 1200px;
    preferred-height: 800px;
    min-width: 800px;
    min-height: 600px;
    background: #1e1e1e;

    callback scan-library(string);
    callback cancel-scan();
    callback play-track(string, float);
    callback stop-track();
    callback select-folder(string);
    callback toggle-folder(string);
    callback expand-all-folders();
    callback collapse-all-folders();
    callback folder-sort-changed(int);
    callback search-tracks(string);
    callback start-drag(string);
    callback seek-track(float);
    callback open-in-file-manager(string);
    callback sort-tracks(string);
    callback toggle-favorite(string);
    callback favorites-filter-changed(bool);
    callback set-volume(float);
    callback reveal-in-tree(string);
    callback remove-folder(string);
    callback search-folders(string);
    callback midi-mode-changed(string);
    callback midi-program-changed(string);
    callback sidebar-width-changed(length);


    in-out property <[TrackData]> tracks: [];
    in-out property <[FolderItem]> folders: [];
    in-out property <string> status-text: "Ready";
    in-out property <string> scan-stage: "";
    in-out property <float> scan-progress: 0.0;
    in-out property <bool> is-scanning: false;
    
    in-out property <string> current-track-name: "-";
    in-out property <string> current-track-info: "-";
    in-out property <float> play-progress: 0.0;
    in-out property <image> waveform-image: @image-url("");
    in-out property <int> selected-index: -1;
    in-out property <bool> is-playing: false;
    in-out property <length> sidebar-width: 250px;
    in-out property <string> selected-folder: "";
    in-out property <string> current-sort-column: "name";
    in-out property <bool> current-sort-asc: true;
    in-out property <bool> favorites-only: false;
    in-out property <float> volume: 1.0;
    in-out property <int> folder-sort-index: 0;
    // -1 = no pending reveal; Rust sets this to a row index after the
    // folders model is rebuilt and the changed-handler scrolls it into
    // view.
    in-out property <int> folder-reveal-index: -1;
    in-out property <string> pending-remove-path: "";
    in-out property <[string]> midi-mode-model: ["Auto", "Synth", "Drums"];
    in-out property <int> midi-mode-index: 0;
    in-out property <[string]> midi-program-model: ["Auto"];
    in-out property <int> midi-program-index: 0;

    forward-focus: main-focus;

    function play-selected() {
        if (root.selected-index >= 0 && root.selected-index < root.tracks.length) {
            root.play-track(root.tracks[root.selected-index].path, 0.0);
        }
    }

    // Keep the selected row inside the viewport; ListView has no
    // bring-into-view, so scroll it manually (rows are a fixed 35px).
    function reveal-selected() {
        if (root.selected-index < 0) { return; }
        if (-track-list.viewport-y > root.selected-index * 35px) {
            track-list.viewport-y = -root.selected-index * 35px;
        } else if (-track-list.viewport-y + track-list.height < (root.selected-index + 1) * 35px) {
            track-list.viewport-y = -((root.selected-index + 1) * 35px - track-list.height);
        }
    }

    // Same for the folder tree (rows are 25px; +1 for the "All" row).
    // Called from Rust after folder-reveal-index is set.
    public function reveal-folder-row() {
        if (root.folder-reveal-index < 0) { return; }
        if (-folder-scroll.viewport-y > (root.folder-reveal-index + 1) * 25px) {
            folder-scroll.viewport-y = -(root.folder-reveal-index + 1) * 25px;
        } else if (-folder-scroll.viewport-y + folder-scroll.height < (root.folder-reveal-index + 2) * 25px) {
            folder-scroll.viewport-y = -((root.folder-reveal-index + 2) * 25px - folder-scroll.height);
        }
    }

    main-focus := FocusScope {
        key-pressed(event) => {
            if (event.text == " ") {
                if (root.is-playing) {
                    root.stop-track();
                } else {
                    root.play-selected();
                }
                return accept;
            }
            if (event.text == Key.UpArrow) {
                if (root.selected-index > 0) {
                    root.selected-index -= 1;
                } else if (root.selected-index == -1 && root.tracks.length > 0) {
                    root.selected-index = 0;
                } else {
                    return accept;
                }
                root.reveal-selected();
                root.play-selected();
                return accept;
            }
            if (event.text == Key.DownArrow) {
                if (root.selected-index < root.tracks.length - 1) {
                    root.selected-index += 1;
                    root.reveal-selected();
                    root.play-selected();
                }
                return accept;
            }
            if (event.text == Key.Return) {
                root.play-selected();
                return accept;
            }
            return reject;
        }

        HorizontalLayout {
        // Sidebar
        VerticalLayout {
            width: sidebar-width;
            padding: 10px;
            spacing: 5px;

            HorizontalLayout {
                spacing: 5px;
                Text {
                    text: "Libraries";
                    color: #ffffff;
                    font-weight: 700;
                    vertical-alignment: center;
                }
                Rectangle { horizontal-stretch: 1; }
                TouchArea {
                    clicked => { root.expand-all-folders(); }
                    Text { text: "[+]"; color: #999; font-size: 12px; vertical-alignment: center; }
                }
                TouchArea {
                    clicked => { root.collapse-all-folders(); }
                    Text { text: "[-]"; color: #999; font-size: 12px; vertical-alignment: center; }
                }
            }

            Button {
                text: "Add Library";
                enabled: !is-scanning;
                clicked => { root.scan-library(""); }
            }

            Rectangle {
                background: #2d2d2d;
                border-radius: 4px;
                height: 25px;
                LineEdit {
                    placeholder-text: "Filter folders...";
                    edited(text) => {
                        root.search-folders(text);
                    }
                }
            }

            HorizontalLayout {
                spacing: 5px;
                height: 26px;
                Text {
                    text: "Sort:";
                    color: #888;
                    font-size: 11px;
                    vertical-alignment: center;
                }
                ComboBox {
                    model: ["Name ↑", "Name ↓", "Tracks ↓", "Tracks ↑"];
                    current-index <=> root.folder-sort-index;
                    horizontal-stretch: 1;
                    selected(v) => { root.folder-sort-changed(root.folder-sort-index); }
                }
            }

            folder-scroll := ScrollView {
                VerticalLayout {
                    alignment: start;
                    // Unscoped view: clicking "All" (or re-clicking the
                    // selected folder) clears the folder scope.
                    Rectangle {
                        height: 25px;
                        background: root.selected-folder == "" ? #2a4d7d : #2b2b2b;
                        border-radius: 2px;
                        TouchArea {
                            clicked => { root.select-folder(""); }
                        }
                        HorizontalLayout {
                            padding-left: 5px;
                            Text {
                                text: "All Tracks";
                                color: #ccc;
                                font-size: 12px;
                                vertical-alignment: center;
                            }
                        }
                    }
                    for folder in folders: Rectangle {
                        property <length> menu-x: 0px;
                        property <length> menu-y: 0px;

                        height: 25px;
                        background: folder.path == root.selected-folder ? #2a4d7d : #2b2b2b;
                        border-radius: 2px;

                        HorizontalLayout {
                            padding-left: 5px + folder.indent;
                            padding-right: 5px;
                            alignment: start;
                            spacing: 5px;

                            if folder.has-children : TouchArea {
                                width: 16px;
                                clicked => { root.toggle-folder(folder.path); }
                                Text {
                                    text: folder.is-expanded ? "v" : ">";
                                    color: #888;
                                    vertical-alignment: center;
                                    horizontal-alignment: center;
                                    font-size: 10px;
                                }
                            }
                            if !folder.has-children : Rectangle { width: 16px; }

                            name-ta := TouchArea {
                                horizontal-stretch: 1;
                                pointer-event(event) => {
                                    if (event.button == PointerEventButton.right && event.kind == PointerEventKind.down) {
                                        menu-x = name-ta.x + self.mouse-x;
                                        menu-y = self.mouse-y;
                                        fmenu.show();
                                    }
                                }
                                clicked => { root.select-folder(folder.path); }
                                Text {
                                    width: 100%;
                                    text: folder.name;
                                    color: #ccc;
                                    vertical-alignment: center;
                                    font-size: 12px;
                                    overflow: elide;
                                }
                            }
                            TouchArea {
                                width: 20px;
                                clicked => { root.scan-library(folder.path); }
                                Text {
                                    text: "↺";
                                    color: #888;
                                    vertical-alignment: center;
                                    horizontal-alignment: center;
                                    font-size: 14px;
                                }
                            }
                            TouchArea {
                                width: 20px;
                                clicked => { root.open-in-file-manager(folder.path); }
                                Text {
                                    text: "📂";
                                    color: #888;
                                    vertical-alignment: center;
                                    horizontal-alignment: center;
                                    font-size: 14px;
                                }
                            }

                        }

                        fmenu := CtxMenu {
                            menu-x: menu-x;
                            menu-y: menu-y;
                            items: ["Rescan", "Open in File Manager", "Expand All", "Collapse All", "Remove from Library..."];
                            item-clicked(i) => {
                                if (i == 0) { root.scan-library(folder.path); }
                                if (i == 1) { root.open-in-file-manager(folder.path); }
                                if (i == 2) { root.expand-all-folders(); }
                                if (i == 3) { root.collapse-all-folders(); }
                                if (i == 4) {
                                    root.pending-remove-path = folder.path;
                                    remove-confirm.show();
                                }
                            }
                        }
                    }
            }
        }
    }

    // Splitter
        Rectangle {
            width: 3px;
            background: #2b2b2b;
            TouchArea {
                mouse-cursor: MouseCursor.col-resize;
                moved => {
                    if (sidebar-width + self.mouse-x > 150px && sidebar-width + self.mouse-x < 500px) {
                        sidebar-width = sidebar-width + self.mouse-x;
                        root.sidebar-width-changed(sidebar-width);
                    }
                }
            }
        }

    // Main Panel
        VerticalLayout {
            padding: 10px;
            spacing: 10px;

            // Header / Search
            HorizontalLayout {
                height: 40px;
                spacing: 10px;
                Rectangle {
                    background: #2d2d2d;
                    border-radius: 4px;
                    width: 200px;
                    LineEdit {
                        placeholder-text: "Search by name or path...";
                        edited(text) => {
                            root.search-tracks(text);
                        }
                    }
                }
                Text {
                    text: "Result: " + tracks.length;
                    color: #aaa;
                    vertical-alignment: center;
                }
                Rectangle {
                    width: 34px;
                    height: 26px;
                    border-radius: 4px;
                    background: root.favorites-only ? #6b5800 : #2d2d2d;
                    TouchArea {
                        clicked => {
                            root.favorites-only = !root.favorites-only;
                            root.favorites-filter-changed(root.favorites-only);
                        }
                    }
                    Text {
                        text: "★";
                        color: root.favorites-only ? #ffcc00 : #777;
                        font-size: 14px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }

            // Track Table Header
            Rectangle {
                height: 25px;
                background: #252525;
                HorizontalLayout {
                    padding-left: 5px;
                    padding-right: 5px;
                    spacing: 5px;
                    
                    TouchArea {
                        horizontal-stretch: 1;
                        clicked => { root.sort-tracks("name"); }
                        HorizontalLayout {
                            alignment: start;
                            Text { text: "Name"; color: #888; }
                            if root.current-sort-column == "name" : Text { text: root.current-sort-asc ? " ▲" : " ▼"; color: #888; }
                        }
                    }
                    TouchArea {
                        width: 120px;
                        clicked => { root.sort-tracks("mtime"); }
                        HorizontalLayout {
                            alignment: start;
                            Text { text: "Updated"; color: #888; }
                            if root.current-sort-column == "mtime" : Text { text: root.current-sort-asc ? " ▲" : " ▼"; color: #888; }
                        }
                    }
                    TouchArea {
                        width: 80px;
                        clicked => { root.sort-tracks("duration"); }
                        HorizontalLayout {
                            alignment: start;
                            Text { text: "Duration"; color: #888; }
                            if root.current-sort-column == "duration" : Text { text: root.current-sort-asc ? " ▲" : " ▼"; color: #888; }
                        }
                    }
                    TouchArea {
                        width: 80px;
                        clicked => { root.sort-tracks("bit_depth"); }
                        HorizontalLayout {
                            alignment: start;
                            Text { text: "BitDepth"; color: #888; }
                            if root.current-sort-column == "bit_depth" : Text { text: root.current-sort-asc ? " ▲" : " ▼"; color: #888; }
                        }
                    }
                    TouchArea {
                        width: 100px;
                        clicked => { root.sort-tracks("sample_rate"); }
                        HorizontalLayout {
                            alignment: start;
                            Text { text: "SampleRate"; color: #888; }
                            if root.current-sort-column == "sample_rate" : Text { text: root.current-sort-asc ? " ▲" : " ▼"; color: #888; }
                        }
                    }
                    TouchArea {
                        width: 80px;
                        clicked => { root.sort-tracks("channels"); }
                        HorizontalLayout {
                            alignment: start;
                            Text { text: "Channels"; color: #888; }
                            if root.current-sort-column == "channels" : Text { text: root.current-sort-asc ? " ▲" : " ▼"; color: #888; }
                        }
                    }
                    TouchArea {
                        width: 60px;
                        clicked => { root.sort-tracks("bpm"); }
                        HorizontalLayout {
                            alignment: start;
                            Text { text: "BPM"; color: #888; }
                            if root.current-sort-column == "bpm" : Text { text: root.current-sort-asc ? " ▲" : " ▼"; color: #888; }
                        }
                    }
                    TouchArea {
                        width: 60px;
                        clicked => { root.sort-tracks("key"); }
                        HorizontalLayout {
                            alignment: start;
                            Text { text: "Key"; color: #888; }
                            if root.current-sort-column == "key" : Text { text: root.current-sort-asc ? " ▲" : " ▼"; color: #888; }
                        }
                    }
                    Text { text: "★"; color: #888; width: 30px; }
                }
            }

            // Track List (Virtualized)
            track-list := ListView {
                for track[i] in tracks: Rectangle {
                    property <length> drag-start-x: 0px;
                    property <length> drag-start-y: 0px;
                    property <bool> drag-active: false;
                    property <length> menu-x: 0px;
                    property <length> menu-y: 0px;

                    height: 35px;
                    background: i == selected-index ? #2d3e50 : (mod(i, 2) == 0 ? #1e1e1e : #252525);
                    
                    // Separator line
                    Rectangle {
                        y: parent.height - 1px;
                        height: 1px;
                        background: #333;
                    }
                    
                    TouchArea {
                        pointer-event(event) => {
                            if (event.button == PointerEventButton.left) {
                                if (event.kind == PointerEventKind.down) {
                                    drag-start-x = self.mouse-x;
                                    drag-start-y = self.mouse-y;
                                    drag-active = true;
                                } else if (event.kind == PointerEventKind.up) {
                                    drag-active = false;
                                }
                            } else if (event.button == PointerEventButton.right && event.kind == PointerEventKind.down) {
                                selected-index = i;
                                menu-x = self.mouse-x;
                                menu-y = self.mouse-y;
                                tmenu.show();
                            }
                        }
                        moved => {
                            if (drag-active) {
                                if (self.mouse-x - drag-start-x > 5px || drag-start-x - self.mouse-x > 5px || self.mouse-y - drag-start-y > 5px || drag-start-y - self.mouse-y > 5px) {
                                    drag-active = false;
                                    root.start-drag(track.path);
                                }
                            }
                        }
                        clicked => { 
                            selected-index = i;
                            main-focus.focus();
                            root.play-track(track.path, 0.0); 
                        }
                    }

                    HorizontalLayout {
                        padding-left: 5px;
                        padding-right: 5px;
                        spacing: 5px;
                        
                        Text { text: track.filename; color: i == selected-index ? #fff : #eee; horizontal-stretch: 1; overflow: elide; vertical-alignment: center; }
                        Text { text: track.mtime; color: i == selected-index ? #fff : #aaa; width: 120px; vertical-alignment: center; }
                        Text { text: track.duration; color: i == selected-index ? #fff : #aaa; width: 80px; vertical-alignment: center; }
                        Text { text: track.bit_depth; color: i == selected-index ? #fff : #aaa; width: 80px; vertical-alignment: center; }
                        Text { text: track.sample_rate; color: i == selected-index ? #fff : #aaa; width: 100px; vertical-alignment: center; }
                        Text { text: track.channels; color: i == selected-index ? #fff : #aaa; width: 80px; vertical-alignment: center; }
                        Text { text: track.bpm; color: i == selected-index ? #fff : #aaa; width: 60px; vertical-alignment: center; }
                        Text { text: track.musical_key; color: i == selected-index ? #fff : #aaa; width: 60px; vertical-alignment: center; overflow: elide; }
                        Text { text: track.is_favorite ? "★" : ""; color: #ffcc00; width: 30px; vertical-alignment: center; horizontal-alignment: center; }
                    }

                    tmenu := CtxMenu {
                        menu-x: menu-x;
                        menu-y: menu-y;
                        items: ["Show in File Manager", track.is_favorite ? "★ Remove Favorite" : "☆ Add Favorite", "Reveal in Folder Tree"];
                        item-clicked(i) => {
                            if (i == 0) { root.open-in-file-manager(track.path); }
                            if (i == 1) { root.toggle-favorite(track.path); }
                            if (i == 2) { root.reveal-in-tree(track.path); }
                        }
                    }
                }
            }

            // Bottom Player Area
            Rectangle {
                // Content-driven height: with the scan row visible the fixed
                // 195px clipped the progress bar / Cancel button.
                height: player-layout.preferred-height;
                background: #111;
                border-radius: 8px;

                player-layout := VerticalLayout {
                    padding: 15px;
                    spacing: 12px;

                    HorizontalLayout {
                        spacing: 20px;
                        alignment: start;
                        Button {
                            text: is-playing ? "Stop" : "Play";
                            width: 100px;
                            clicked => {
                                if (is-playing) { 
                                    root.stop-track(); 
                                } else {
                                    if (root.selected-index >= 0) {
                                        root.play-track(root.tracks[root.selected-index].path, 0.0);
                                    }
                                }
                            }
                        }
                        if root.selected-index >= 0 : Button {
                            text: "Show Folder";
                            width: 110px;
                            clicked => { root.open-in-file-manager(root.tracks[root.selected-index].path); }
                        }
                        if root.selected-index >= 0 : Button {
                            text: root.tracks[root.selected-index].is_favorite ? "★" : "☆";
                            width: 45px;
                            clicked => { root.toggle-favorite(root.tracks[root.selected-index].path); }
                        }

                        HorizontalLayout {
                            spacing: 8px;
                            Text {
                                text: "Vol";
                                color: #888;
                                font-size: 11px;
                                vertical-alignment: center;
                            }
                            Slider {
                                width: 110px;
                                minimum: 0;
                                maximum: 1;
                                value <=> root.volume;
                                changed(v) => { root.set-volume(v); }
                            }
                        }

                        VerticalLayout {
                            alignment: center;
                            Text {
                                text: root.current-track-name;
                                color: #fff;
                                font-size: 16px;
                                font-weight: 700;
                            }
                            Text {
                                text: root.current-track-info;
                                color: #888;
                                font-size: 11px;
                                overflow: elide;
                            }
                        }
                    }

                    // MIDI channel mode + program (inert for audio files)
                    HorizontalLayout {
                        spacing: 8px;
                        Text {
                            text: "Ch:";
                            color: #888;
                            font-size: 11px;
                            vertical-alignment: center;
                        }
                        ComboBox {
                            model: root.midi-mode-model;
                            current-index <=> root.midi-mode-index;
                            width: 90px;
                            selected(v) => { root.midi-mode-changed(v); }
                        }
                        Text {
                            text: "Sound:";
                            color: #888;
                            font-size: 11px;
                            vertical-alignment: center;
                        }
                        ComboBox {
                            model: root.midi-program-model;
                            current-index <=> root.midi-program-index;
                            horizontal-stretch: 1;
                            selected(v) => { root.midi-program-changed(v); }
                        }
                    }

                    // Waveform Display
                    Rectangle {
                        height: 70px;
                        background: #000;
                        border-radius: 4px;
                        clip: true;
                        
                        Image {
                            source: root.waveform-image;
                            width: 100%;
                            height: 100%;
                            image-fit: fill;
                        }
                        
                        // Progress overlay
                        Rectangle {
                            x: 0;
                            width: parent.width * root.play-progress;
                            background: #ff5500;
                            opacity: 0.3;
                        }
                        TouchArea {
                            clicked => {
                                if (!is-playing && root.selected-index >= 0) {
                                    root.play-track(root.tracks[root.selected-index].path, self.mouse-x / self.width);
                                } else {
                                    root.seek-track(self.mouse-x / self.width);
                                }
                            }
                        }
                    }
                    
                    if is-scanning : HorizontalLayout {
                        spacing: 10px;
                        ProgressIndicator {
                            progress: scan-progress;
                            width: 200px;
                        }
                        Button {
                            text: "Cancel";
                            clicked => { root.cancel-scan(); }
                        }
                    }
                    Text {
                        text: scan-stage == "" ? "Status: " + status-text : "Status: " + scan-stage + " " + status-text;
                        font-size: 11px;
                        color: #aaa;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }
            }
        }
        }
    }

    // Confirm for "Remove from Library" (DB rows only — files are kept).
    remove-confirm := PopupWindow {
        x: root.width / 2 - 170px;
        y: root.height / 3;
        width: 340px;
        height: 130px;
        close-on-click: true;

        Rectangle {
            width: 100%;
            height: 100%;
            background: #232323;
            border-radius: 6px;
            border-width: 1px;
            border-color: #666;

            VerticalLayout {
                padding: 12px;
                spacing: 8px;
                Text {
                    text: "Remove \"" + root.pending-remove-path + "\" and its tracks from the library?";
                    color: #eee;
                    font-size: 12px;
                    wrap: word-wrap;
                }
                Text {
                    text: "Files on disk are not deleted.";
                    color: #888;
                    font-size: 11px;
                }
                HorizontalLayout {
                    spacing: 10px;
                    alignment: end;
                    Button {
                        text: "Cancel";
                        clicked => { remove-confirm.close(); }
                    }
                    Button {
                        text: "Remove";
                        clicked => {
                            root.remove-folder(root.pending-remove-path);
                            remove-confirm.close();
                        }
                    }
                }
            }
        }
    }
}
